{
  "name": "@leafycoding/coscli",
  "version": "0.1.0",
  "description": "A Node.js and TypeScript CLI for Tencent Cloud COS.",
  "keywords": [
    "cli",
    "cos",
    "coscli",
    "tencent-cloud",
    "typescript"
  ],
  "license": "MIT",
  "author": "leafycoding <skytakeawaygolang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/yxb123456cy/coscli.git"
  },
  "bin": {
    "coscli": "./bin/coscli.js"
  },
  "directories": {
    "lib": "src",
    "bin": "bin"
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup-node",
    "build:watch": "tsup-node --watch",
    "clean": "rimraf dist",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "compile": "tsc",
    "cpd": "jscpd src",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxfmt . && oxlint .",
    "start": "ts-node ./bin/coscli.ts",
    "start:node": "node ./bin/coscli",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "giget": "^3.3.0",
    "ora": "^9.4.1",
    "p-limit": "^7.3.1",
    "p-retry": "^8.0.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@jest/globals": "^30.4.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tsconfig/node20": "^20.1.9",
    "@types/commander": "^2.12.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/prompts": "^2.4.9",
    "@types/signale": "^1.4.7",
    "@types/yargs": "^17.0.35",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jscpd": "^5.0.12",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.8",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
